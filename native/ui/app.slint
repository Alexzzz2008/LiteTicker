import { ScrollView, ListView } from "std-widgets.slint";
export { SettingsWindow, SearchWindow } from "dialogs.slint";

export struct QuoteRow { name: string, price: string, change: string, volume: string, ink: color }
export struct LadderRow { label: string, price: string, size: string, ink: color }
export struct TradeRow { time: string, price: string, size: string, ink: color }

component Action inherits Rectangle {
    in property <string> label;
    in property <bool> accent: false;
    in property <length> text-size: 19px;
    private property <length> horizontal-padding: 12px * (text-size / 19px);
    callback activated();
    preferred-width: button-text.preferred-width + 2 * horizontal-padding;
    min-width: self.preferred-width; horizontal-stretch: 0;
    border-width: root.accent ? 0px : 1px;
    border-color: #42464f;
    border-radius: 3px;
    background: accent ? (focus.has-focus ? #9e2a37 : #86202b) : touch.has-hover || focus.has-focus ? #34373f : #24272d;
    button-text := Text { x: root.horizontal-padding; width: max(0px, parent.width - 2 * root.horizontal-padding); height: parent.height; text: root.label; color: #efeeec; font-size: root.text-size; horizontal-alignment: center; vertical-alignment: center; }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }
    forward-focus: focus;
    touch := TouchArea { clicked => { focus.focus(); root.activated(); } }
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.activated(); }
}

export component MainWindow inherits Window {
    title: "轻量看盘";
    no-frame: true;
    background: #1d1c20;
    default-font-family: "Microsoft YaHei UI";
    in property <float> q-scale: 1;
    in property <float> g-scale: 1;
    in property <[QuoteRow]> rows;
    in property <string> footer;
    in-out property <int> selection: -1;
    in-out property <bool> pointer-down: false;
    callback select-row(int);
    callback open-row(int);
    callback hover-row(int, bool);
    callback context(int);
    callback drag();
    callback cancel-hover();
    callback key-action(string);
    preferred-width: 550px * q-scale;
    preferred-height: (14px + 43px * max(1, min(12, rows.length))) * q-scale + 34px * g-scale;
    property <length> quote-content-width: max(0px, list.visible-width - 16px * q-scale);
    property <length> quote-gap: max(0px, (quote-content-width - 356px * q-scale) / 3);
    property <length> quote-price-end: 200px * q-scale + quote-gap;
    property <length> quote-change-end: quote-price-end + 86px * q-scale + quote-gap;
    property <length> quote-name-width: 140px * q-scale;
    property <length> quote-price-width: 140px * q-scale;
    property <length> quote-change-width: min(116px * q-scale, max(0px, quote-change-end - quote-price-end - 8px * q-scale));
    property <length> quote-volume-width: min(108px * q-scale, max(0px, quote-content-width - quote-change-end - 8px * q-scale));
    min-width: 480px * q-scale;
    min-height: 76px * q-scale + 34px * g-scale;
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return { root.open-row(root.selection); return accept; }
            if event.text == Key.Delete { root.key-action("delete"); return accept; }
            if event.text == Key.F5 { root.key-action("refresh"); return accept; }
            if event.text == Key.UpArrow || event.text == Key.DownArrow {
                if event.modifiers.control { root.key-action(event.text == Key.UpArrow ? "up" : "down"); }
                else if root.rows.length > 0 { root.select-row(max(0, min(root.rows.length - 1, root.selection + (event.text == Key.UpArrow ? -1 : 1)))); }
                return accept;
            }
            return reject;
        }
    }
    forward-focus: keys;
    VerticalLayout {
        x: 0px; y: 0px; width: root.width; height: root.height;
        padding-left: 8px * root.q-scale; padding-right: 8px * root.q-scale; padding-top: 8px * root.q-scale;
        list := ListView {
            for row[i] in root.rows: Rectangle {
                height: 43px * root.q-scale;
                background: i == root.selection ? #302f38 : transparent;
                Text { x: 8px * root.q-scale; width: min(root.quote-name-width, max(0px, root.quote-price-end - min(quote-price.preferred-width, root.quote-price-width) - 8px * root.q-scale)); height: parent.height; text: row.name; color: #dedce0; overflow: elide; font-size: 28px * root.q-scale; vertical-alignment: center; }
                quote-price := Text { x: 8px * root.q-scale + root.quote-price-end - root.quote-price-width; width: root.quote-price-width; height: parent.height; text: row.price; color: row.ink; overflow: elide; horizontal-alignment: right; vertical-alignment: center; font-family: "Consolas"; font-weight: 700; font-size: 28px * root.q-scale; }
                Text { x: 8px * root.q-scale + root.quote-change-end - root.quote-change-width; width: root.quote-change-width; height: parent.height; text: row.change; color: row.ink; overflow: elide; horizontal-alignment: right; vertical-alignment: center; font-family: "Consolas"; font-weight: 700; font-size: 26px * root.q-scale; }
                Text { x: 8px * root.q-scale + root.quote-content-width - root.quote-volume-width; width: root.quote-volume-width; height: parent.height; text: row.volume; color: #9898a3; overflow: elide; horizontal-alignment: right; vertical-alignment: center; font-family: "Consolas"; font-size: 22px * root.q-scale; }
                TouchArea {
                    width: parent.width; height: parent.height;
                    private property <bool> dragging: false;
                    moved => {
                        if self.pressed && !self.dragging && max(abs(self.mouse-x - self.pressed-x), abs(self.mouse-y - self.pressed-y)) >= 4px {
                            self.dragging = true;
                            root.drag();
                        }
                    }
                    changed has-hover => { root.hover-row(i, self.has-hover); }
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.move && !self.pressed {
                            root.hover-row(i, true);
                        } else if event.kind == PointerEventKind.down {
                            root.pointer-down = event.button == PointerEventButton.left;
                            root.cancel-hover();
                            self.dragging = false;
                            keys.focus(); root.select-row(i);
                            if event.button == PointerEventButton.right { root.context(i); }
                        } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                            root.pointer-down = false;
                            root.hover-row(i, self.has-hover);
                        }
                    }
                    double-clicked => { if !self.dragging { root.open-row(i); } }
                }
            }
        }
        Rectangle {
            height: 34px * root.g-scale;
            Text { x: 4px; text: root.footer; font-size: 16px * root.g-scale; color: #9898a3; vertical-alignment: center; overflow: elide; }
            TouchArea {
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        root.pointer-down = e.button == PointerEventButton.left;
                        root.cancel-hover();
                        if e.button == PointerEventButton.right {root.context(root.selection);}
                        else if e.button == PointerEventButton.left {root.drag();}
                    } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                        root.pointer-down = false;
                    }
                }
            }
        }
    }
}
export component DetailsWindow inherits Window {
    title: "轻量看盘盘口"; no-frame: true; background: #1d1c20;
    default-font-family: "Microsoft YaHei UI";
    in property <float> scale: 1;
    in property <string> heading;
    in property <string> price;
    in property <string> average-price;
    in property <color> ink;
    in property <string> status;
    in property <string> trades-title;
    in property <[LadderRow]> ladder;
    in property <[TradeRow]> trades;
    in property <image> chart;
    in property <[string]> axis;
    in property <string> first-date;
    in property <string> last-date;
    in property <bool> has-chart;
    in property <bool> has-depth;
    in property <bool> pinned;
    in property <bool> daily;
    in property <bool> amount;
    private property <float> vertical-scale: min(root.scale, root.height / 700px);
    private property <length> book-header-height: 36px * vertical-scale;
    private property <length> book-row-height: 1.25 * root.default-font-size;
    callback command(string);
    callback hover(bool);
    preferred-width: 960px * scale; preferred-height: 840px * scale;
    min-width: 540px * scale; min-height: 470px * scale;
    touch := TouchArea { changed has-hover => { root.hover(self.has-hover); } }
    VerticalLayout {
        x: 0px; y: 0px; width: root.width; height: root.height;
        padding-left: 18px * root.scale; padding-right: 18px * root.scale;
        padding-top: 18px * root.vertical-scale; padding-bottom: 18px * root.vertical-scale;
        spacing: 4px * root.vertical-scale;
        HorizontalLayout {
            height: 46px * root.vertical-scale; spacing: 8px * root.scale;
            Text { text: root.heading; color: #dedce0; font-size: 30px * root.vertical-scale; font-weight: 700; vertical-alignment: center;
                WindowMoveArea {}
            }
            Action {text-size: 19px * root.scale; width: 100px * root.scale; label: root.pinned ? "已固定" : "固定"; activated => {root.command("pin");}}
            Action {text-size: 19px * root.scale; width: 86px * root.scale; label: "关闭"; activated => {root.command("close");}}
        }
        Text { height: 46px * root.vertical-scale; text: root.price; color: root.ink; font-size: 32px * root.vertical-scale; font-weight: 700; }
        HorizontalLayout {
            height: 39px * root.vertical-scale; spacing: 8px * root.scale;
            Action {text-size: 19px * root.scale; width: 98px * root.scale; label: "分时"; accent: !root.daily; activated => {root.command("minute");}}
            Action {text-size: 19px * root.scale; width: 98px * root.scale; label: "日 K"; accent: root.daily; activated => {root.command("daily");}}
            Text {
                text: root.daily ? "日 K" : root.width < 650px * root.scale ? "价格 · 均价" : "白线 价格 · 金线 均价";
                horizontal-stretch: 0; color: #a4a8b1; vertical-alignment: center;
            }
            if !root.daily: Text {
                text: root.average-price == "" ? "—" : root.average-price;
                horizontal-stretch: 0; color: root.average-price == "" ? #a4a8b1 : #dcb24e;
                font-family: "Consolas"; vertical-alignment: center;
            }
            Rectangle {}
        }
        chart-area := Rectangle {
            vertical-stretch: 1; min-height: 60px * root.scale; background: #19181c;
            property <length> axis-width: max(72px * root.scale, axis-measure.preferred-width + 12px * root.scale);
            property <length> tick-height: 26px * root.scale;
            axis-measure := Text {
                visible: false; font-size: 19px * root.scale;
                text: root.axis.length == 5 ? root.axis[0] + "\n" + root.axis[1] + "\n" + root.axis[2] + "\n" + root.axis[3] + "\n" + root.axis[4] : "";
                wrap: no-wrap;
            }
            // Labels and the raster share this exact plot, including both endpoints.
            plot := Image {
                x: chart-area.axis-width; y: chart-area.tick-height / 2;
                width: parent.width - self.x; height: parent.height - chart-area.tick-height;
                visible: root.has-chart; source: root.chart; image-fit: fill;
                accessible-label: "分时与日K走势图";
            }
            for tick[i] in root.axis: Text {
                visible: root.has-chart; text: tick; color: #908e9c; font-size: 19px * root.scale;
                x: 0px; width: chart-area.axis-width - 8px * root.scale; height: chart-area.tick-height;
                y: plot.y + plot.height * i / 4 - self.height / 2;
                horizontal-alignment: right; vertical-alignment: center;
            }
            if !root.has-chart: Text {text: root.daily ? "日 K 暂无数据" : "分时暂无数据"; color:#9595a1; horizontal-alignment:center; vertical-alignment:center;}
        }
        Rectangle {
            height: 28px * root.vertical-scale;
            for label[i] in root.daily ? [root.first-date, root.last-date] : ["09:30","10:30","11:30 / 13:00","14:00","15:00"]: Text {
                text: label; color: #a4a8b1; width: self.preferred-width;
                x: plot.x + max(0px, min(plot.width - self.width, plot.width * i / (root.daily ? 1 : 4) - self.width / 2));
            }
        }
        books := HorizontalLayout {
            height: root.book-header-height + 10 * root.book-row-height; spacing: 20px * root.scale;
            ladder-table := VerticalLayout {
                width: (books.width - 20px * root.scale) / 2;
                property <length> gap: 8px * root.scale;
                property <length> table-font: min(root.default-font-size, max(1px * root.scale, (self.width - 3 * gap) / (root.amount ? 12 : 10)));
                property <length> label-width: 2 * table-font;
                property <length> quantity-width: (root.amount ? 6 : 4) * table-font;
                property <length> price-width: 4 * table-font;
                property <length> price-end: max(label-width + gap + price-width, min(self.width - gap - quantity-width, self.width / 2 + (root.amount ? 0.55 : 1.4) * table-font));
                HorizontalLayout { height: root.book-header-height; spacing: 8px * root.scale;
                    Text {width: max(0px, ladder-table.width - 98px * root.scale); text: !root.has-depth ? "五档暂无数据" : root.amount ? "五档 · 金额（元）" : "五档盘口 · 手"; color: #b4b3bc; vertical-alignment: center; overflow: elide;}
                    Action {text-size: 19px * root.scale; width: 90px * root.scale; visible: root.has-depth; label: root.amount ? "看手数" : "看金额"; activated => {root.command("unit");}}
                }
                for level in root.ladder: HorizontalLayout {
                    height: root.book-row-height; spacing: 0px;
                    Text {width: ladder-table.label-width; font-size: ladder-table.table-font; text: level.label; color: #a4a8b1; overflow: elide;}
                    Rectangle {width: ladder-table.price-end - ladder-table.label-width - ladder-table.price-width;}
                    Text {width: ladder-table.price-width; font-size: ladder-table.table-font; text: level.price; color: level.ink; font-family: "Consolas"; horizontal-alignment: right; overflow: elide;}
                    Rectangle {min-width: ladder-table.gap; horizontal-stretch: 1;}
                    Text {width: ladder-table.quantity-width; font-size: ladder-table.table-font; text: level.size; color: #a4a8b1; font-family: "Consolas"; horizontal-alignment: right; overflow: elide;}
                }
            }
            trades-table := VerticalLayout {
                width: (books.width - 20px * root.scale) / 2;
                property <length> gap: 8px * root.scale;
                property <length> table-font: min(root.default-font-size, max(1px * root.scale, (self.width - 3 * gap) / 12.5));
                property <length> time-width: 4.5 * table-font;
                property <length> quantity-width: 4 * table-font;
                property <length> price-width: 4 * table-font;
                property <length> price-end: max(time-width + gap + price-width, min(self.width - gap - quantity-width, self.width / 2 + 2.85 * table-font));
                Text {height: root.book-header-height; text: root.trades-title; color: #b4b3bc; vertical-alignment: center; overflow: elide;}
                for trade in root.trades: HorizontalLayout {
                    height: root.book-row-height; spacing: 0px;
                    Text {width: trades-table.time-width; font-size: trades-table.table-font; text: trade.time; color: #a4a8b1; font-family: "Consolas"; overflow: elide;}
                    Rectangle {width: trades-table.price-end - trades-table.time-width - trades-table.price-width;}
                    Text {width: trades-table.price-width; font-size: trades-table.table-font; text: trade.price; color: trade.ink; horizontal-alignment: right; font-family: "Consolas"; overflow: elide;}
                    Rectangle {min-width: trades-table.gap; horizontal-stretch: 1;}
                    Text {width: trades-table.quantity-width; font-size: trades-table.table-font; text: trade.size; color: #a4a8b1; horizontal-alignment: right; font-family: "Consolas"; overflow: elide;}
                }
            }
        }
        Text {height: 26px * root.scale; text: root.status; color: #a4a8b1; overflow: elide;}
    }
    default-font-size: min(24px * scale, root.height / 33);
}
